# Receipts example environment. Copy to .env.local (frontend) or
# .env (Python pipeline). Placeholder values only. Never commit real keys.
# Frontend
NEXT_PUBLIC_API_URL=https://<your-project>.supabase.co/functions/v1/api
# Shared
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
GEMINI_API_KEY=<your-gemini-api-key>
TAVILY_API_KEY=<your-tavily-api-key>
# Meterless Nightshift, optional. The provider only activates when
# METERLESS_BASE_URL is set. Otherwise generation uses Gemini.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=<your-meterless-runtime-token>
METERLESS_MODEL=meterless/auto
# Zetaris, optional. Insights answer locally unless both the base URL
# and API key are set.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_API_KEY=<your-zetaris-api-key>
ZETARIS_ORG_ID=<your-zetaris-org-id>
